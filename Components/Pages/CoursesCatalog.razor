@page "/courses"
@inject ICourseService CourseService

<AuthGuard>
    <div class="mb-4 text-center">
        <h2 class="fw-bold">Course Catalog</h2>
        <p class="text-muted">Browse all available courses offered this semester.</p>
    </div>

    <div class="row g-4">
        @if (!_courses.Any())
        {
            <div class="col-12 text-center text-muted py-5">
                <i class="bi bi-journal-x" style="font-size: 3rem;"></i>
                <p class="mt-3">No courses available at the moment.</p>
            </div>
        }
        else
        {
            @foreach (var course in _courses)
            {
                <div class="col-md-6 col-lg-4">
                    <CourseCard Course="course" ShowEnrollButton="false" />
                </div>
            }
        }
    </div>
</AuthGuard>

@code {
    private IEnumerable<Course> _courses = new List<Course>();

    protected override void OnInitialized()
    {
        _courses = CourseService.GetAllCourses().OrderBy(c => c.Title);
    }
}
