@page "/notifications"
@inject NotificationService NotificationService
@inject AuthStateService AuthStateService

<AuthGuard>
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold">Notifications</h2>
            <p class="text-muted">View all your alerts and announcements.</p>
        </div>
        @if (_notifications.Any(n => !n.IsRead))
        {
            <button class="btn btn-outline-primary" @onclick="MarkAllAsRead">Mark All as Read</button>
        }
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (!_notifications.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-bell-slash" style="font-size: 3rem;"></i>
                    <p class="mt-3">You have no notifications.</p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush rounded-3">
                    @foreach (var note in _notifications)
                    {
                        <button class="list-group-item list-group-item-action d-flex gap-3 py-3 @(note.IsRead ? "" : "bg-light")" aria-current="true" @onclick="() => MarkAsRead(note.Id)">
                            <div class="d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle" style="width: 48px; height: 48px; min-width: 48px;">
                                @if (note.Type == NotificationType.Announcement)
                                {
                                    <i class="bi bi-megaphone-fill fs-5"></i>
                                }
                                else if (note.Type == NotificationType.GradePosted)
                                {
                                    <i class="bi bi-journal-check fs-5"></i>
                                }
                                else if (note.Type == NotificationType.Enrollment)
                                {
                                    <i class="bi bi-check-circle-fill fs-5"></i>
                                }
                                else
                                {
                                    <i class="bi bi-info-circle-fill fs-5"></i>
                                }
                            </div>
                            <div class="d-flex w-100 justify-content-between align-items-start">
                                <div>
                                    <h6 class="mb-1 fw-bold @(!note.IsRead ? "text-dark" : "text-muted")">@note.Type</h6>
                                    <p class="mb-1 @(!note.IsRead ? "text-dark fw-medium" : "text-muted")">@note.Message</p>
                                    <small class="text-muted">@note.CreatedAt.ToString("f")</small>
                                </div>
                                @if (!note.IsRead)
                                {
                                    <span class="badge bg-primary rounded-pill mt-2">New</span>
                                }
                            </div>
                        </button>
                    }
                </div>
            }
        </div>
    </div>
</AuthGuard>

@code {
    private List<Notification> _notifications = new();

    protected override void OnInitialized()
    {
        NotificationService.OnNewNotification += HandleNewNotification;
        LoadNotifications();
    }

    private void HandleNewNotification(Notification notification)
    {
        if (AuthStateService.CurrentUser != null && notification.UserId == AuthStateService.CurrentUser.Id)
        {
            LoadNotifications();
            InvokeAsync(StateHasChanged);
        }
    }

    private void LoadNotifications()
    {
        if (AuthStateService.CurrentUser != null)
        {
            _notifications = NotificationService.GetNotificationsForUser(AuthStateService.CurrentUser.Id).ToList();
        }
    }

    private void MarkAsRead(Guid id)
    {
        NotificationService.MarkAsRead(id);
        LoadNotifications();
    }

    private void MarkAllAsRead()
    {
        foreach (var note in _notifications.Where(n => !n.IsRead))
        {
            NotificationService.MarkAsRead(note.Id);
        }
        LoadNotifications();
    }

    public void Dispose()
    {
        NotificationService.OnNewNotification -= HandleNewNotification;
    }
}
