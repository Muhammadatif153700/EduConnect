@page "/admin/reports/grades"
@inject IStudentService StudentService

<AuthGuard AllowedRoles="new[] { Role.Admin }">
    <div class="mb-4">
        <h2 class="fw-bold">Grade Report</h2>
        <p class="text-muted">Summary of student performance and GPA distribution.</p>
    </div>

    <div class="row mb-4 g-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 border-success h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold">Excellent (A/B)</h6>
                    <h2 class="display-5 fw-bold mb-0">@_excellentCount</h2>
                    <small class="text-muted">CGPA &ge; 3.0</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 border-warning h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold">Average (C)</h6>
                    <h2 class="display-5 fw-bold mb-0">@_averageCount</h2>
                    <small class="text-muted">CGPA 2.0 - 2.99</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 border-danger h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold">At Risk (D/F)</h6>
                    <h2 class="display-5 fw-bold mb-0">@_atRiskCount</h2>
                    <small class="text-muted">CGPA &lt; 2.0</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 border-primary h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-bold">Average Univ. CGPA</h6>
                    <h2 class="display-5 fw-bold mb-0">@_overallAverage.ToString("0.00")</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Rank</th>
                            <th>Student Name</th>
                            <th>Semester</th>
                            <th>CGPA</th>
                            <th class="text-end pe-4">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!_students.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No students found.</td>
                            </tr>
                        }
                        else
                        {
                            var rank = 1;
                            @foreach (var student in _students)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">#@rank</td>
                                    <td class="fw-bold">@student.FullName</td>
                                    <td>@student.Semester</td>
                                    <td>
                                        <span class="badge @(student.CGPA >= 3.0 ? "bg-success" : student.CGPA >= 2.0 ? "bg-warning text-dark" : "bg-danger") fs-6">
                                            @student.CGPA.ToString("0.00")
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (student.CGPA >= 3.5)
                                        {
                                            <span class="text-success"><i class="bi bi-star-fill me-1"></i> Dean's List</span>
                                        }
                                        else if (student.CGPA < 2.0 && student.CGPA > 0)
                                        {
                                            <span class="text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i> Probation</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Good Standing</span>
                                        }
                                    </td>
                                </tr>
                                rank++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</AuthGuard>

@code {
    private List<Student> _students = new();
    private int _excellentCount = 0;
    private int _averageCount = 0;
    private int _atRiskCount = 0;
    private double _overallAverage = 0;

    protected override void OnInitialized()
    {
        _students = StudentService.GetAllStudents().OrderByDescending(s => s.CGPA).ToList();

        if (_students.Any())
        {
            _excellentCount = _students.Count(s => s.CGPA >= 3.0);
            _averageCount = _students.Count(s => s.CGPA >= 2.0 && s.CGPA < 3.0);
            _atRiskCount = _students.Count(s => s.CGPA < 2.0 && s.CGPA > 0); // Ignore 0.0 for new students
            
            var studentsWithGPA = _students.Where(s => s.CGPA > 0).ToList();
            if (studentsWithGPA.Any())
            {
                _overallAverage = studentsWithGPA.Average(s => s.CGPA);
            }
        }
    }
}
